{
  "version": 1,
  "base_branch": "main",
  "readme": "README.md",
  "repository_policy": "AGENTS.md",
  "verification": [
    [
      "npm",
      "--prefix",
      "expo-app",
      "run",
      "typecheck"
    ],
    [
      "npm",
      "--prefix",
      "expo-app",
      "run",
      "test:coverage"
    ]
  ],
  "coverage": {
    "format": "istanbul",
    "report": "expo-app/coverage/coverage-final.json",
    "source_directory": "expo-app/src"
  }
}
